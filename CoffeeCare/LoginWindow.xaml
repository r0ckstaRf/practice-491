<Window x:Class="CoffeeCare.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeCare - вход" Width="400" Height="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="30">
        <TextBlock Text="☕ CoffeeCare" FontSize="28" FontWeight="Bold" Foreground="#4E342E" HorizontalAlignment="Center"/>
        <TextBlock Text="Сеть кофеен самообслуживания" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="Gray"/>

        <TextBlock Text="Email"/>
        <TextBox x:Name="txtEmail" Height="28" FontSize="14" Margin="0,2,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="txtPass" Height="28" FontSize="14" Margin="0,2,0,10" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="txtError" Foreground="Red" TextWrapping="Wrap" MinHeight="35"/>

        <Button x:Name="btnLogin" Content="Войти" Height="34" FontSize="15" IsDefault="True" Click="Login_Click"/>

        <TextBlock Margin="0,15,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Демо: admin@coffee.local / admin123&#x0a;dispatcher@coffee.local / disp123&#x0a;manager@coffee.local / manager123&#x0a;tech@coffee.local / tech123"/>
    </StackPanel>
</Window>
