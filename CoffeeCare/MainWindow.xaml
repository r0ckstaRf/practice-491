<Window x:Class="CoffeeCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeCare" Width="1180" Height="720" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AlternatingRowBackground" Value="#F5EFEA"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#4E342E" Padding="10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выйти" Click="Logout_Click" Margin="0"/>
                <TextBlock x:Name="txtUser" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="tabs" Margin="5">

            <!-- ЗАЯВКИ -->
            <TabItem x:Name="tabOrders" Header="Заявки">
                <DockPanel Margin="5">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="OrdersRefresh_Click"/>
                        <Button x:Name="btnOrderNew" Content="Создать заявку" Click="OrderNew_Click"/>
                        <Button x:Name="btnOrderAssign" Content="Назначить техника" Click="OrderAssign_Click"/>
                        <Button Content="Сменить статус" Click="OrderStatus_Click"/>
                        <Button x:Name="btnOrderProtocol" Content="Оформить протокол" Click="OrderProtocol_Click"/>
                        <Button Content="История" Click="OrderHistory_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridOrders"/>
                </DockPanel>
            </TabItem>

            <!-- КОФЕМАШИНЫ -->
            <TabItem x:Name="tabMachines" Header="Кофемашины и точки">
                <DockPanel Margin="5">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="MachRefresh_Click"/>
                        <Button x:Name="btnMachAdd" Content="Добавить кофемашину" Click="MachAdd_Click"/>
                        <Button x:Name="btnMachStatus" Content="Сменить статус" Click="MachStatus_Click"/>
                        <Button x:Name="btnMachDelete" Content="Удалить" Click="MachDelete_Click"/>
                        <Button x:Name="btnLocAdd" Content="Добавить точку" Click="LocAdd_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridMachines"/>
                </DockPanel>
            </TabItem>

            <!-- НАПИТКИ -->
            <TabItem x:Name="tabDrinks" Header="Напитки и цены">
                <DockPanel Margin="5">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="DrinkRefresh_Click"/>
                        <Button Content="Добавить напиток" Click="DrinkAdd_Click"/>
                        <Button Content="Изменить цену" Click="DrinkPrice_Click"/>
                        <Button Content="Вкл/выкл в продаже" Click="DrinkToggle_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridDrinks"/>
                </DockPanel>
            </TabItem>

            <!-- ПРОДАЖИ -->
            <TabItem x:Name="tabSales" Header="Продажи">
                <DockPanel Margin="5">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="SaleRefresh_Click"/>
                        <Button Content="Добавить продажу" Click="SaleAdd_Click"/>
                        <Button Content="Выручка по точкам" Click="SaleRevenue_Click"/>
                        <Button Content="Отчет в CSV" Click="SaleCsv_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridSales"/>
                </DockPanel>
            </TabItem>

            <!-- ПОЛЬЗОВАТЕЛИ -->
            <TabItem x:Name="tabUsers" Header="Пользователи">
                <DockPanel Margin="5">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="UserRefresh_Click"/>
                        <Button Content="Добавить пользователя" Click="UserAdd_Click"/>
                        <Button Content="Назначить роль" Click="UserRole_Click"/>
                        <Button Content="Блок/разблок" Click="UserToggle_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridUsers"/>
                </DockPanel>
            </TabItem>

            <!-- ЖУРНАЛ ВХОДОВ -->
            <TabItem x:Name="tabLog" Header="Журнал входов">
                <DockPanel Margin="5">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="LogRefresh_Click"/>
                        <TextBlock Text="Последние 200 записей" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,6"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridLog"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
